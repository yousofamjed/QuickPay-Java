{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(mvn *)",
      "Bash(./mvnw *)",
      "Bash(java -version)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git ls-files*)",
      "Bash(git add *)",
      "Bash(git switch *)",
      "Bash(git checkout -b *)",
      "Bash(git stash*)",
      "Bash(docker compose *)",
      "Bash(docker ps*)",
      "Bash(docker logs *)",
      "Bash(npm install*)",
      "Bash(npm ci*)",
      "Bash(npm run *)",
      "Bash(npm test*)",
      "Bash(npx ng *)",
      "Bash(ng *)",
      "Bash(curl *localhost*)",
      "Bash(ls *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(cat *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(sed -n *)",
      "Bash(wc *)",
      "Bash(jq *)",
      "mcp__context7__*",
      "mcp__angular-cli__*",
      "mcp__postgres__*",
      "mcp__playwright__*"
    ],
    "ask": [
      "Bash(git commit *)",
      "Bash(git push*)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(docker compose down*)",
      "Bash(docker rm *)",
      "Bash(docker volume *)",
      "Bash(npm publish*)",
      "Bash(rm *)",
      "Edit(payments/application/src/main/resources/db/changelog/**)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git clean -f*)",
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(sudo *)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(~/.ssh/**)",
      "Read(~/.m2/settings*.xml)"
    ]
  }
}
