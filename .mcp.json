{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@4.1.1"]
    },
    "angular-cli": {
      "command": "npx",
      "args": ["-y", "@angular/cli@22.2.1", "mcp"]
    },
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.83"]
    },
    "postgres": {
      "command": "npx",
      "args": ["-y", "@bytebase/dbhub@1.4.0", "--config=.claude/dbhub.toml"]
    }
  }
}
